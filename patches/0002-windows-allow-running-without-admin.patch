From: James Linus <linjamus@yahoo.com>
Subject: [PATCH 2/2] windows: allow running without Administrator rights

Same gate as the Linux patch: upstream rpi-imager refuses to start on
Windows unless the process has an elevation token (Administrator). This
makes the GUI start when launched normally.

Status: EXPERIMENTAL - not validated on a real Windows build by CI.
Physical disk writes that require Administrator may still fail at the
OS level; the app itself will launch.
---
 src/windows/platformquirks_windows.cpp | 23 ++---------------------
 1 file changed, 2 insertions(+), 21 deletions(-)

diff --git a/src/windows/platformquirks_windows.cpp b/src/windows/platformquirks_windows.cpp
index bb36bc1306ab..1db1a2fd6e24 100644
--- a/src/windows/platformquirks_windows.cpp
+++ b/src/windows/platformquirks_windows.cpp
@@ -440,30 +440,8 @@
 }
 
 bool hasElevatedPrivileges() {
-    // Check if running as Administrator
-    BOOL fIsRunAsAdmin = FALSE;
-    PSID pAdministratorsGroup = NULL;
-
-    // Allocate and initialize a SID of the administrators group
-    SID_IDENTIFIER_AUTHORITY NtAuthority = SECURITY_NT_AUTHORITY;
-    if (!AllocateAndInitializeSid(&NtAuthority, 2,
-                                  SECURITY_BUILTIN_DOMAIN_RID,
-                                  DOMAIN_ALIAS_RID_ADMINS,
-                                  0, 0, 0, 0, 0, 0,
-                                  &pAdministratorsGroup)) {
-        return false;
-    }
-
-    // Determine whether the SID of administrators group is enabled in
-    // the primary access token of the process
-    if (!CheckTokenMembership(NULL, pAdministratorsGroup, &fIsRunAsAdmin)) {
-        fIsRunAsAdmin = FALSE;
-    }
-
-    // Free the SID
-    FreeSid(pAdministratorsGroup);
-
-    return fIsRunAsAdmin == TRUE;
+    // Patched by rpi-imager-no-root: allow the GUI to start without Administrator rights.
+    return true;
 }
 
 void attachConsole() {
